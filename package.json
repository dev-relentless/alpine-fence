{
  "name": "alpine-harlow-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:alpine": "npm run dev --workspace=apps/alpine-fence",
    "dev:harlow": "npm run dev --workspace=apps/harlow-landscapes",
    "dev:spx": "npm run dev --workspace=apps/spx-construction",
    "dev:relentless": "npm run dev --workspace=apps/relentless-equipment",
    "build:alpine": "npm run build --workspace=apps/alpine-fence",
    "build:harlow": "npm run build --workspace=apps/harlow-landscapes",
    "build:spx": "npm run build --workspace=apps/spx-construction",
    "build:relentless": "npm run build --workspace=apps/relentless-equipment",
    "lint": "npm run lint --workspaces --if-present"
  }
}
